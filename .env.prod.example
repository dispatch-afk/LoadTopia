# =============================================================================
# LoadTopia — self-hosted PRODUCTION environment TEMPLATE (docker-compose.prod.yml)
# Copy to `.env.prod` and fill in. NEVER commit `.env.prod` (git-ignored via .env.*).
# =============================================================================

# Your domain on Cloudflare DNS. The stack uses app.<domain>, api.<domain>, files.<domain>.
LT_DOMAIN=

# Cloudflare Tunnel connector token (Zero Trust > Networks > Tunnels > your tunnel > Install connector).
# Treat as a secret.
CF_TUNNEL_TOKEN=

# --- Secrets (generate: openssl rand -hex 24) ---------------------------------
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Optional ----------------------------------------------------------------
STORAGE_S3_BUCKET=loadtopia-prod
SESSION_COOKIE_NAME=loadtopia_session
SESSION_TTL_HOURS=168
LOG_LEVEL=info
# Real routing/geocoding (external Google Maps Platform). Leave mock for the PoC.
ROUTING_PROVIDER=mock
GEOCODING_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
