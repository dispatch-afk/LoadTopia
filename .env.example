# =============================================================================
# LoadTopia — environment configuration TEMPLATE
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The API validates every variable on boot (apps/api/src/config/env.ts).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- API server ------------------------------------------------------------- -
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL 16) ----------------------------------------------- -
# Matches docker-compose.yml service `postgres`.
DATABASE_URL=postgresql://loadtopia:loadtopia_dev_pw@localhost:5432/loadtopia?schema=public
# Optional separate database used by the integration test suite.
TEST_DATABASE_URL=postgresql://loadtopia:loadtopia_dev_pw@localhost:5432/loadtopia_test?schema=public

# --- Sessions / auth ------------------------------------------------------- ---
SESSION_COOKIE_NAME=loadtopia_session
SESSION_TTL_HOURS=168
# Set to true in any environment served over HTTPS.
SESSION_COOKIE_SECURE=false
# Optional cookie domain (leave blank for host-only cookies).
COOKIE_DOMAIN=

# --- Password hashing (Argon2id) ----------------------------------------------
# OWASP baseline: 19 MiB memory, 2 iterations, 1 lane.
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1

# --- Rate limiting ----------------------------------------------------------- -
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
# Marketplace write ops (offer create, counter, reject, withdraw). Generous
# enough for a dispatcher working many loads at once.
MARKETPLACE_WRITE_RATE_LIMIT_MAX=30
MARKETPLACE_WRITE_RATE_LIMIT_WINDOW=1 minute
# Load award (offer accept) — deliberately tighter; a real shipper awards a
# handful of loads per minute at most.
MARKETPLACE_AWARD_RATE_LIMIT_MAX=15
MARKETPLACE_AWARD_RATE_LIMIT_WINDOW=1 minute

# --- Logging --------------------------------------------------------------- ---
LOG_LEVEL=info

# --- External providers -----------------------------------------------------
# `mock` is the only value most of these support today. Never point a provider
# at a real service without an implemented, reviewed adapter + credentials
# handling in packages/providers. Local dev, CI, and tests should stay on
# `mock` — never set these to `google` outside a deliberately configured
# environment (e.g. Render production).
#
# ROUTING_PROVIDER / GEOCODING_PROVIDER also accept `google` (real Google
# Maps Platform routing/geocoding — see the GOOGLE_* keys below). Selecting
# `google` with no key configured fails at boot; there is no runtime fallback
# to mock.
ROUTING_PROVIDER=mock
PRICING_PROVIDER=mock
GEOCODING_PROVIDER=mock
# Carrier authority / insurance verification. The `mock` adapter is deterministic
# development data ONLY — it does NOT contact FMCSA, DOT, SAFER, or any insurance
# or government source and must never be represented as such.
CARRIER_VERIFICATION_PROVIDER=mock
PAYMENT_PROVIDER=mock
STORAGE_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
TRACKING_PROVIDER=mock

# --- Google Maps Platform (only used when ROUTING_PROVIDER/GEOCODING_PROVIDER
# is `google`) -----------------------------------------------------------------
# Server-side only — never referenced by apps/web, never NEXT_PUBLIC_*, never
# sent to the browser. Real secret in any non-local environment; never commit
# a real value here. Enable the Routes API and Geocoding API on the Google
# Cloud project this key belongs to; restrict the key to those two APIs.
# Phase 1 uses travelMode DRIVE (real road routing) — NOT Google's truck /
# Large Vehicle Routing mode, which needs vehicle data LoadTopia doesn't
# collect and is a separately access-gated Google feature.
GOOGLE_MAPS_API_KEY=
# Optional per-API overrides — leave blank to use GOOGLE_MAPS_API_KEY for both.
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# --- Web (Next.js) --------------------------------------------------------- ---
# Origin the web server reverse-proxies /api/* to. The browser only ever talks
# to the web origin, so the session cookie stays first-party.
API_ORIGIN=http://localhost:4000
# Session cookie name — must match the API's SESSION_COOKIE_NAME.
SESSION_COOKIE_NAME=loadtopia_session
