{
  "name": "loadtopia",
  "version": "0.0.0",
  "private": true,
  "description": "LoadTopia — direct freight marketplace connecting shippers with qualified carriers.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:integration": "dotenv -e .env -- pnpm -r test:integration",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @loadtopia/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @loadtopia/db migrate:dev",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @loadtopia/db migrate:deploy",
    "db:validate": "dotenv -e .env -- pnpm --filter @loadtopia/db validate",
    "db:seed": "dotenv -e .env -- pnpm --filter @loadtopia/db seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @loadtopia/db studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
