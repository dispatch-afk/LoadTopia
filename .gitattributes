# Normalize line endings: LF in the repo, native in the working tree.
* text=auto eol=lf

# Always LF (executed in Linux containers / shells).
*.sh text eol=lf
*.mjs text eol=lf
Dockerfile text eol=lf

# Lockfiles and generated SQL: LF, and don't diff-explode.
pnpm-lock.yaml text eol=lf -diff
*.sql text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
