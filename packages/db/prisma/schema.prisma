// LoadTopia database schema.
//
// Conventions:
//   * Primary keys: UUID (gen_random_uuid() — Postgres 13+ core). Column type is
//     `uuid`; adopting UUIDv7 later is an app-side generation change, not a
//     schema migration.
//   * Timestamps: `timestamptz(6)`, always UTC. `created_at` defaulted,
//     `updated_at` via @updatedAt.
//   * Money: NUMERIC(14,2) via Prisma `Decimal` — never floating point.
//   * All snake_case table/column names via @map/@@map.
//   * Historical/append-only tables (load_events, market_rates, audit_logs) are
//     never updated or deleted by application code. `load_events` is additionally
//     enforced append-only by a database trigger (see the m1_foundation migration).

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev + CI (linux-x64 / linux-arm64 / darwin).
  // The extra targets cover the production container images (Debian slim, Alpine).
  // NOTE: Prisma has no windows-arm64 engine — on a Windows/ARM host, run the
  // database-backed workflow (migrate, seed, integration tests, the server)
  // inside WSL2. Windows/ARM natively supports install, typecheck, lint, unit
  // tests, and `prisma generate` only.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirror packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum CompanyType {
  SHIPPER
  CARRIER
}

enum UserRole {
  SHIPPER
  CARRIER
  ADMIN
}

enum LoadStatus {
  DRAFT
  POSTED
  OFFER_RECEIVED
  AWARDED
  CARRIER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum TransportMode {
  FTL
  LTL
  PARTIAL
}

enum EquipmentType {
  DRY_VAN
  REEFER
  FLATBED
  STEP_DECK
  CONESTOGA
  BOX_TRUCK
  POWER_ONLY
  HOTSHOT
  OTHER
}

enum LoadEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  OFFER_CREATED
  OFFER_ACCEPTED
  OFFER_REJECTED
  NOTE_ADDED
  CANCELLED
  // --- Milestone 3 (Operations) ---
  CHECK_IN_ADDED
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
  DOCUMENT_REMOVED
  EXCEPTION_REPORTED
  // --- Milestone 4 Phase 4 (freight audience strategy) ---
  LOAD_POSTED_TO_MARKETPLACE
  LOAD_POSTED_TO_NETWORK
  LOAD_POSTED_TO_SELECTED_CARRIERS
  MARKETPLACE_RELEASE_SCHEDULED
  NETWORK_RELEASE_SCHEDULED
  LOAD_RELEASED_TO_NETWORK
  LOAD_RELEASED_TO_MARKETPLACE
  RELEASE_RESCHEDULED
  RELEASE_CANCELLED
}

// --- Operations (Milestone 3) --------------------------------------------- -

/// Operational document category. The Rate Confirmation is a separate,
/// system-generated record (see RateConfirmationStatus) — never a row here.
enum DocumentType {
  BOL
  POD
  OTHER
}

/// Current review pointer on a LoadDocument (POD only — null for BOL/OTHER).
/// Mutable, mirroring OfferThread.status; the immutable history lives in
/// DocumentReview, mirroring OfferEvent.
enum DocumentReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// A single immutable review decision (DocumentReview.decision) — narrower
/// than DocumentReviewStatus, which also has the non-decision PENDING_REVIEW.
enum DocumentReviewDecision {
  APPROVED
  REJECTED
}

/// Rate Confirmation render/storage status. Never gates the commercial
/// snapshot's own validity — only whether the rendered artifact exists yet.
enum RateConfirmationStatus {
  PENDING
  GENERATED
  FAILED
}

// --- Marketplace (Milestone 2) -------------------------------------------- --

enum CarrierOperatingStatus {
  ACTIVE
  INACTIVE
}

enum MarketplaceEligibility {
  PENDING
  ELIGIBLE
  INELIGIBLE
  SUSPENDED
}

enum CarrierVerificationStatus {
  UNVERIFIED
  VERIFYING
  VERIFIED
  FAILED
}

/// The mutable status of a negotiation. The individual `OfferRound` rows are
/// immutable; this is the single source of truth for whether a thread is live.
enum OfferThreadStatus {
  ACTIVE
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum OfferEventType {
  CREATED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

// (The Phase 0 `OfferStatus` enum + `LoadOffer` placeholder are replaced by the
//  Milestone 2 OfferThread / OfferRound / OfferEvent model below.)

// --- Relationship network (Milestone 4 Phase 2) ---------------------------

/// Mutable current state of a company-to-company Connection. There is no
/// stored "NONE" — the absence of a CompanyConnection row IS "none".
enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  DISCONNECTED
}

/// Immutable connection lifecycle event type. Deliberately no separate
/// RE_REQUESTED value — see CompanyConnectionEvent's doc comment.
enum ConnectionEventType {
  REQUESTED
  ACCEPTED
  DECLINED
  DISCONNECTED
}

/// A shipper's PRIVATE preference on a carrier. Never a rating, never public.
enum CarrierPreferenceType {
  PREFER
  DO_NOT_PREFER
}

/// Lifecycle of one CompanyBlock episode.
enum CompanyBlockStatus {
  PENDING_ON_COMPLETION
  ACTIVE
  INACTIVE
}

// --- Freight audience strategy (Milestone 4 Phase 4) -----------------------

/// The shipper's chosen distribution strategy, fixed at Review & Post. Never
/// changes after posting — audience WIDENS over time via `currentStage`
/// advancing, never by picking a different strategy.
enum LoadAudienceStrategyType {
  MARKETPLACE
  NETWORK_FIRST
  SELECTED_FIRST
}

/// The current visibility boundary for a load's audience. Ordered
/// SELECTED < NETWORK < MARKETPLACE — `currentStage` only ever advances
/// forward (see LoadAudienceStrategyRecord.currentStage / the release engine).
enum LoadAudienceStage {
  SELECTED
  NETWORK
  MARKETPLACE
}

/// Lifecycle of one scheduled (or manually triggered) audience-widening
/// action. PENDING rows are claimed compare-and-set by the release engine —
/// see LoadAudienceRelease.
enum LoadReleaseStatus {
  PENDING
  RELEASED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity & organizations
// ---------------------------------------------------------------------------

model Company {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      CompanyType
  name      String
  mcNumber  String?     @map("mc_number")
  dotNumber String?     @map("dot_number")

  // Contact / address (Milestone 1). Nullable so self-service registration can
  // create a company with just a name and fill these in later.
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  state        String?
  postalCode   String? @map("postal_code")
  country      String  @default("US")
  phone        String?
  email        String?

  // Per-company human-readable load numbering (Milestone 1).
  // `loadNumberPrefix` is globally unique so `{prefix}-{sequence}` is globally
  // unique without a retry loop; `loadSequence` is bumped inside the
  // create-load transaction.
  loadNumberPrefix String @map("load_number_prefix")
  loadSequence     Int    @default(0) @map("load_sequence")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships          Membership[]
  activeSessions       Session[]       @relation("SessionActiveCompany")
  locations            Location[]
  equipment            Equipment[]
  shippedLoads         Load[]          @relation("ShipperLoads")
  carriedLoads         Load[]          @relation("CarrierLoads")
  carrierProfile       CarrierProfile?
  carrierOfferThreads  OfferThread[]   @relation("ThreadCarrier")
  proposedOfferRounds  OfferRound[]    @relation("RoundProposedByCompany")
  offerEvents          OfferEvent[]
  loadEventsActedFor         LoadEvent[]
  uploadedDocuments          LoadDocument[]
  documentReviews            DocumentReview[]
  rateConfirmationsAsShipper RateConfirmation[] @relation("RateConfirmationShipper")
  rateConfirmationsAsCarrier RateConfirmation[] @relation("RateConfirmationCarrier")

  // Relationship network (Milestone 4 Phase 2)
  followsAsCarrier          CarrierFollow[]        @relation("FollowCarrier")
  followsAsShipper          CarrierFollow[]        @relation("FollowShipper")
  connectionsAsCompanyA     CompanyConnection[]    @relation("ConnectionCompanyA")
  connectionsAsCompanyB     CompanyConnection[]    @relation("ConnectionCompanyB")
  connectionsInitiated      CompanyConnection[]    @relation("ConnectionRequester")
  connectionEvents          CompanyConnectionEvent[]
  preferencesAsShipper      CarrierPreference[]    @relation("PreferenceShipper")
  preferencesAsCarrier      CarrierPreference[]    @relation("PreferenceCarrier")
  blocksAsBlocker           CompanyBlock[]         @relation("BlockBlocking")
  blocksAsBlocked           CompanyBlock[]         @relation("BlockBlocked")
  carrierGroups             CarrierGroup[]         @relation("CarrierGroupShipper")
  carrierGroupMemberships   CarrierGroupMember[]   @relation("CarrierGroupMemberCarrier")

  @@unique([type, name])
  @@unique([loadNumberPrefix])
  @@index([type])
  @@map("companies")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         Membership[]
  sessions            Session[]
  auditLogs           AuditLog[]
  loadEvents          LoadEvent[]
  createdLoads        Load[]         @relation("LoadCreatedBy")
  updatedLoads        Load[]         @relation("LoadUpdatedBy")
  proposedOfferRounds OfferRound[]   @relation("RoundProposedByUser")
  offerEvents         OfferEvent[]
  pricingSnapshots    PricingSnapshot[]
  loadCheckIns        LoadCheckIn[]
  uploadedDocuments   LoadDocument[]
  documentReviews     DocumentReview[]

  // Relationship network (Milestone 4 Phase 2)
  connectionsRequested   CompanyConnection[]      @relation("ConnectionRequestedByUser")
  connectionsRespondedTo CompanyConnection[]      @relation("ConnectionRespondedByUser")
  connectionEvents       CompanyConnectionEvent[]
  carrierPreferencesSet  CarrierPreference[]
  blocksCreated          CompanyBlock[]           @relation("BlockCreatedByUser")
  blocksRemoved          CompanyBlock[]           @relation("BlockRemovedByUser")

  // Freight audience strategy (Milestone 4 Phase 4)
  audienceStrategiesCreated LoadAudienceStrategyRecord[]
  audienceReleasesCreated   LoadAudienceRelease[]

  @@map("users")
}

/// Join of User <-> Company carrying the user's role WITHIN that company.
/// A user may belong to multiple companies with different roles. `isActive`
/// gates whether the membership can be used for authorization / company switch.
model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  role      UserRole
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Facility scope (Milestone 4 Phase 2). No rows = company-wide access;
  /// one or more rows = restricted to those Locations only.
  facilityScope MembershipFacilityScope[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId, isActive])
  @@map("company_users")
}

/// Opaque server-side session. Only the SHA-256 hash of the token is stored.
/// `activeCompanyId` is the company the user is currently acting on behalf of;
/// it is always verified against an active membership on each request.
model Session {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  activeCompanyId String?   @map("active_company_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip              String?
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompany Company? @relation("SessionActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeCompanyId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Company reference data (Milestone 1)
// ---------------------------------------------------------------------------

/// Reusable company location book entry. Every location belongs to exactly one
/// company; there is no cross-company access. Coordinates come from the
/// GeocodingProvider abstraction (mock in dev) and feed RoutingProvider.
model Location {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String?
  addressLine1   String   @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String
  state          String
  postalCode     String   @map("postal_code")
  country        String   @default("US")
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  providerPlaceId String? @map("provider_place_id")
  geocodedBy     String?  @map("geocoded_by")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  originLoads Load[]  @relation("LoadOrigin")
  destLoads   Load[]  @relation("LoadDestination")

  /// Facility scope (Milestone 4 Phase 2): memberships restricted to this
  /// Location as one of their facilities.
  facilityScopeFor MembershipFacilityScope[]

  @@index([companyId, isActive])
  @@index([state, city])
  @@map("locations")
}

/// Carrier equipment record. Company-scoped; a company manages only its own.
model Equipment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  type           EquipmentType
  name           String?
  trailerLengthFt Int?         @map("trailer_length_ft")
  capacityLbs    Int?          @map("capacity_lbs")
  description    String?
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, isActive])
  @@map("equipment")
}

// ---------------------------------------------------------------------------
// Pricing placeholders — Phase 0. NOT populated, calculated, or exposed in
// Milestone 1. Kept for future milestones; do not remove.
// ---------------------------------------------------------------------------

/// A directional origin->destination corridor. Rates are attached over time.
model Lane {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originRegion      String   @map("origin_region")
  originCity        String   @default("") @map("origin_city")
  destinationRegion String   @map("destination_region")
  destinationCity   String   @default("") @map("destination_city")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  marketRates MarketRate[]

  @@unique([originRegion, originCity, destinationRegion, destinationCity])
  @@map("lanes")
}

/// APPEND-ONLY. Each row is one observation of a rate for a lane/equipment at a
/// point in time. Never updated or deleted — this is core pricing history.
/// NOT used in Milestone 1.
model MarketRate {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  laneId        String        @map("lane_id") @db.Uuid
  equipmentType EquipmentType @map("equipment_type")
  source        String
  isMock        Boolean       @default(false) @map("is_mock")
  lowRate       Decimal       @map("low_rate") @db.Decimal(14, 2)
  midRate       Decimal       @map("mid_rate") @db.Decimal(14, 2)
  highRate      Decimal       @map("high_rate") @db.Decimal(14, 2)
  ratePerMile   Decimal?      @map("rate_per_mile") @db.Decimal(10, 4)
  currency      String        @default("USD")
  observedAt    DateTime      @map("observed_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  lane Lane @relation(fields: [laneId], references: [id], onDelete: Cascade)

  @@index([laneId, equipmentType, observedAt])
  @@index([source, observedAt])
  @@map("market_rates")
}

// ---------------------------------------------------------------------------
// Loads
// ---------------------------------------------------------------------------

model Load {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceNumber       String        @unique @map("reference_number")
  status                LoadStatus    @default(DRAFT)
  shipperCompanyId      String        @map("shipper_company_id") @db.Uuid
  // Reserved for Milestone 2 (marketplace). Never set or exposed in Milestone 1.
  carrierCompanyId      String?       @map("carrier_company_id") @db.Uuid
  createdByUserId       String        @map("created_by_user_id") @db.Uuid
  updatedByUserId       String?       @map("updated_by_user_id") @db.Uuid
  originLocationId      String        @map("origin_location_id") @db.Uuid
  destinationLocationId String        @map("destination_location_id") @db.Uuid
  equipmentType         EquipmentType @map("equipment_type")
  mode                  TransportMode @default(FTL)
  commodity             String?
  weightLbs             Int?          @map("weight_lbs")
  pickupWindowStart     DateTime?     @map("pickup_window_start") @db.Timestamptz(6)
  pickupWindowEnd       DateTime?     @map("pickup_window_end") @db.Timestamptz(6)
  deliveryWindowStart   DateTime?     @map("delivery_window_start") @db.Timestamptz(6)
  deliveryWindowEnd     DateTime?     @map("delivery_window_end") @db.Timestamptz(6)

  // `bookedRate` is set at award time — a direct Decimal copy of the winning
  // offer round's amount. `offeredRate` remains a reserved placeholder (unused).
  offeredRate Decimal? @map("offered_rate") @db.Decimal(14, 2)
  bookedRate  Decimal? @map("booked_rate") @db.Decimal(14, 2)
  currency    String   @default("USD")

  // Routing results (via RoutingProvider abstraction).
  distanceMeters   Int?      @map("distance_meters")
  driveTimeMinutes Int?      @map("drive_time_minutes")
  routingProvider  String?   @map("routing_provider")
  routedAt         DateTime? @map("routed_at") @db.Timestamptz(6)

  // Marketplace award outcome (Milestone 2).
  awardedOfferRoundId String?   @unique @map("awarded_offer_round_id") @db.Uuid
  awardedAt           DateTime? @map("awarded_at") @db.Timestamptz(6)
  assignedAt          DateTime? @map("assigned_at") @db.Timestamptz(6)

  postedAt    DateTime? @map("posted_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  // Operational lifecycle (Milestone 3). Reserved in the LoadStatus enum and
  // the domain state machine since Phase 0; unexposed until now — see
  // EXPOSED_LOAD_STATUSES. No historical row can have ever reached these
  // statuses before this migration, so all three are safely null-by-default.
  pickedUpAt  DateTime? @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  shipperCompany   Company           @relation("ShipperLoads", fields: [shipperCompanyId], references: [id], onDelete: Restrict)
  carrierCompany   Company?          @relation("CarrierLoads", fields: [carrierCompanyId], references: [id], onDelete: Restrict)
  createdBy        User              @relation("LoadCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy        User?             @relation("LoadUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  origin           Location          @relation("LoadOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination      Location          @relation("LoadDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  awardedOfferRound OfferRound?      @relation("LoadAwardedRound", fields: [awardedOfferRoundId], references: [id], onDelete: SetNull)
  events           LoadEvent[]
  offerThreads     OfferThread[]
  pricingSnapshots PricingSnapshot[]
  checkIns         LoadCheckIn[]
  documents        LoadDocument[]
  rateConfirmation RateConfirmation?

  /// Freight audience strategy (Milestone 4 Phase 4). At most one row — absent
  /// for every load posted before this feature shipped (see
  /// LoadAudienceStrategyRecord's doc comment for the historical-compatibility
  /// rule this null encodes).
  audienceStrategy LoadAudienceStrategyRecord?
  audienceMembers  LoadAudienceMember[]
  audienceReleases LoadAudienceRelease[]

  @@index([status])
  @@index([shipperCompanyId, status])
  @@index([shipperCompanyId, createdAt])
  @@index([carrierCompanyId])
  @@index([equipmentType, status])
  @@index([createdAt])
  // Marketplace board: loads on market, newest first, filterable by equipment.
  @@index([status, postedAt])
  @@index([status, equipmentType, postedAt])
  @@map("loads")
}

/// IMMUTABLE append-only load audit trail. Application code only ever INSERTs;
/// a database trigger rejects UPDATE and DELETE (m1_foundation migration).
model LoadEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadId         String        @map("load_id") @db.Uuid
  type           LoadEventType
  fromStatus     LoadStatus?   @map("from_status")
  toStatus       LoadStatus?   @map("to_status")
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  /// Milestone 3: which company the actor was acting for. Null for every
  /// pre-Milestone-3 event (only the shipper ever wrote one before, so it was
  /// never captured) — never backfilled from later, possibly-changed
  /// membership state. Mirrors OfferEvent.actorCompanyId exactly.
  actorCompanyId String?       @map("actor_company_id") @db.Uuid
  note           String?
  data           Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  load         Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorCompany Company? @relation(fields: [actorCompanyId], references: [id], onDelete: SetNull)

  @@index([loadId, createdAt])
  @@index([type, createdAt])
  @@map("load_events")
}

// ---------------------------------------------------------------------------
// Marketplace — carrier profiles, offers/negotiation, pricing (Milestone 2)
// ---------------------------------------------------------------------------

/// One per CARRIER-type company. Holds marketplace-facing identity, self-declared
/// capabilities, and the eligibility/verification state that gates participation.
model CarrierProfile {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String                    @unique @map("company_id") @db.Uuid
  legalName             String                    @map("legal_name")
  mcNumber              String?                   @map("mc_number")
  dotNumber             String?                   @map("dot_number")
  operatingStatus       CarrierOperatingStatus    @default(ACTIVE) @map("operating_status")
  marketplaceEligibility MarketplaceEligibility   @default(PENDING) @map("marketplace_eligibility")
  eligibilityReason     String?                   @map("eligibility_reason")
  verificationStatus    CarrierVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verificationProvider  String?                   @map("verification_provider")
  verificationIsMock    Boolean?                  @map("verification_is_mock")
  verificationRef       String?                   @map("verification_ref")
  verificationNote      String?                   @map("verification_note")
  verifiedAt            DateTime?                 @map("verified_at") @db.Timestamptz(6)
  /// Self-declared equipment the carrier can haul. Empty => no equipment filter.
  equipmentTypes        EquipmentType[]           @map("equipment_types")
  /// Self-declared operating area (2-letter state codes). Empty => nationwide.
  serviceAreaStates     String[]                  @map("service_area_states")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([marketplaceEligibility])
  @@map("carrier_profiles")
}

/// A negotiation between one carrier and one shipper-load. The container is
/// mutable (its `status`); the `OfferRound` rows it holds are immutable.
model OfferThread {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadId           String            @map("load_id") @db.Uuid
  carrierCompanyId String            @map("carrier_company_id") @db.Uuid
  status           OfferThreadStatus @default(ACTIVE)
  roundCount       Int               @default(0) @map("round_count")
  currentRoundId   String?           @unique @map("current_round_id") @db.Uuid
  closedReason     String?           @map("closed_reason")
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  load           Load         @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrierCompany Company      @relation("ThreadCarrier", fields: [carrierCompanyId], references: [id], onDelete: Cascade)
  currentRound   OfferRound?  @relation("ThreadCurrentRound", fields: [currentRoundId], references: [id], onDelete: SetNull)
  rounds         OfferRound[] @relation("ThreadRounds")
  events         OfferEvent[]

  @@unique([loadId, carrierCompanyId])
  @@index([carrierCompanyId, status])
  @@index([loadId, status])
  @@map("offer_threads")
}

/// IMMUTABLE. One row per proposal or counter. A DB trigger rejects UPDATE and
/// DELETE. The full commercial history of a negotiation is these rows.
model OfferRound {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId            String   @map("thread_id") @db.Uuid
  roundNumber         Int      @map("round_number")
  proposedByCompanyId String   @map("proposed_by_company_id") @db.Uuid
  proposedByUserId    String   @map("proposed_by_user_id") @db.Uuid
  amount              Decimal  @db.Decimal(14, 2)
  currency            String   @default("USD")
  message             String?
  /// Deadline for the OTHER party to respond to this proposal.
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  parentRoundId       String?  @unique @map("parent_round_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread            OfferThread  @relation("ThreadRounds", fields: [threadId], references: [id], onDelete: Cascade)
  proposedByCompany Company      @relation("RoundProposedByCompany", fields: [proposedByCompanyId], references: [id], onDelete: Restrict)
  proposedByUser    User         @relation("RoundProposedByUser", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  parentRound       OfferRound?  @relation("RoundChain", fields: [parentRoundId], references: [id], onDelete: SetNull)
  childRound        OfferRound?  @relation("RoundChain")
  currentOfThread   OfferThread? @relation("ThreadCurrentRound")
  awardedLoad       Load?        @relation("LoadAwardedRound")
  rateConfirmation  RateConfirmation? @relation("RateConfirmationAwardedRound")

  @@unique([threadId, roundNumber])
  @@index([threadId, createdAt])
  @@map("offer_rounds")
}

/// IMMUTABLE append-only negotiation event log (reuses loadtopia_reject_mutation).
model OfferEvent {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId       String         @map("thread_id") @db.Uuid
  roundId        String?        @map("round_id") @db.Uuid
  type           OfferEventType
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  actorCompanyId String?        @map("actor_company_id") @db.Uuid
  data           Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  thread       OfferThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  actor        User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorCompany Company?    @relation(fields: [actorCompanyId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([type, createdAt])
  @@map("offer_events")
}

/// IMMUTABLE. A pricing estimate produced for a load at a point in time, so a
/// historical price is reproducible and never silently recomputed.
model PricingSnapshot {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadId          String        @map("load_id") @db.Uuid
  provider        String
  isMock          Boolean       @map("is_mock")
  currency        String        @default("USD")
  lowRate         Decimal       @map("low_rate") @db.Decimal(14, 2)
  midRate         Decimal       @map("mid_rate") @db.Decimal(14, 2)
  highRate        Decimal       @map("high_rate") @db.Decimal(14, 2)
  ratePerMile     Decimal?      @map("rate_per_mile") @db.Decimal(10, 4)
  confidence      String
  disclaimer      String?
  distanceMeters  Int?          @map("distance_meters")
  equipmentType   EquipmentType @map("equipment_type")
  originState     String        @map("origin_state")
  destinationState String       @map("destination_state")
  inputsHash      String?       @map("inputs_hash")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  load      Load  @relation(fields: [loadId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([loadId, createdAt])
  @@map("pricing_snapshots")
}

// ---------------------------------------------------------------------------
// Operations (Milestone 3) — post-award shipment lifecycle
// ---------------------------------------------------------------------------

/// Manual carrier location/status check-ins (tracking Level B). APPEND-ONLY at
/// the database level (loadtopia_reject_mutation trigger, migration
/// 20260907120000) — INSERT only; UPDATE/DELETE rejected by PostgreSQL, like
/// load_events / document_reviews. First-party operational data — NOT
/// provider-abstracted; TrackingProvider stays reserved for a future
/// automated-telematics milestone.
model LoadCheckIn {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadId      String   @map("load_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  city        String
  state       String
  note        String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  /// When the check-in was recorded in LoadTopia — the SERVER clock at write
  /// time (the same `now` as the CHECK_IN_ADDED event's transaction). The M3
  /// manual flow does not accept a client-supplied timestamp; this is not a
  /// device time and not a GPS fix time.
  recordedAt  DateTime @map("recorded_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  load  Load @relation(fields: [loadId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([loadId, recordedAt])
  @@map("load_check_ins")
}

/// Operational, user-submitted evidence — BOL / POD / OTHER. The Rate
/// Confirmation is a separate, system-generated record (see
/// RateConfirmation) and is never a row here.
///
/// Two-stage upload: a row is created at request time with confirmedAt =
/// null and is invisible to every list/read endpoint and never reviewable
/// until the client confirms the underlying object upload actually
/// succeeded (confirmedAt set, and — for a POD — reviewStatus set to
/// PENDING_REVIEW only at that moment, never at request time).
model LoadDocument {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadId              String                @map("load_id") @db.Uuid
  docType             DocumentType          @map("doc_type")
  uploadedByUserId    String                @map("uploaded_by_user_id") @db.Uuid
  uploadedByCompanyId String                @map("uploaded_by_company_id") @db.Uuid
  /// Server-generated at request time: loads/{loadId}/documents/{id} —
  /// never client-supplied.
  storageKey          String                @map("storage_key")
  /// Checked against the upload allowlist before a signed upload is issued.
  contentType         String                @map("content_type")
  sizeBytes           Int?                  @map("size_bytes")
  originalFilename    String?               @map("original_filename")
  confirmedAt         DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  /// POD only; set to PENDING_REVIEW at confirm time. Null for BOL/OTHER.
  reviewStatus        DocumentReviewStatus? @map("review_status")
  /// Only meaningful for a corrected POD re-upload after rejection. The
  /// service layer enforces: same load, doc_type = POD, review_status =
  /// REJECTED on the referenced row.
  replacesDocumentId  String?               @map("replaces_document_id") @db.Uuid
  /// Soft-delete only — never a hard DELETE. Settable only under the
  /// narrowed rule in the application layer: PENDING_REVIEW POD or
  /// non-terminal BOL/OTHER, uploader's own company, non-terminal load.
  /// An APPROVED or REJECTED POD is never removable by any normal user.
  removedAt           DateTime?             @map("removed_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  load              Load             @relation(fields: [loadId], references: [id], onDelete: Cascade)
  uploadedByUser    User             @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadedByCompany Company          @relation(fields: [uploadedByCompanyId], references: [id], onDelete: Restrict)
  replacesDocument  LoadDocument?    @relation("DocumentReplacement", fields: [replacesDocumentId], references: [id], onDelete: SetNull)
  replacedBy        LoadDocument[]   @relation("DocumentReplacement")
  reviews           DocumentReview[]

  @@index([loadId, docType])
  // What assertCompletionReadiness() queries: doc_type='POD' AND
  // review_status='APPROVED' AND removed_at IS NULL.
  @@index([loadId, docType, reviewStatus])
  @@map("load_documents")
}

/// IMMUTABLE. One row per POD review decision — the audit trail behind
/// LoadDocument.reviewStatus, structurally identical in role to OfferEvent
/// behind OfferThread.status. documentId is UNIQUE: a specific document
/// receives at most one terminal review decision, guaranteed by the
/// database — not application row-locking alone (mirrors the existing
/// "DB partial unique guarantees ≤ 1 per load" precedent on offer_threads).
model DocumentReview {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId        String                 @unique @map("document_id") @db.Uuid
  reviewerUserId    String                 @map("reviewer_user_id") @db.Uuid
  reviewerCompanyId String                 @map("reviewer_company_id") @db.Uuid
  decision          DocumentReviewDecision
  /// Required at the API layer iff decision = REJECTED.
  reason            String?
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  document        LoadDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer        User         @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)
  reviewerCompany Company      @relation(fields: [reviewerCompanyId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@map("document_reviews")
}

/// IMMUTABLE commercial snapshot, generated entirely by LoadTopia (never
/// uploaded), persisted inside OffersService.accept()'s existing award
/// transaction — the commercial agreement is created by offer acceptance,
/// NOT by carrier assignment. At most one per load (see the dormant
/// AWARDED -> POSTED transition note in docs/MILESTONE-3.md for why this is
/// safe under the currently-reachable lifecycle).
///
/// Enforced by a dedicated trigger (loadtopia_protect_commercial_snapshot)
/// that permits ONLY status/storageKey/generatedAt to change post-insert;
/// every field below that line is written once, at insert, never again.
/// DELETE is prohibited unconditionally.
model RateConfirmation {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadId          String                 @unique @map("load_id") @db.Uuid
  referenceNumber String                 @unique @map("reference_number")
  status          RateConfirmationStatus @default(PENDING)
  /// Deterministic: rate-confirmations/{loadId}/{id}.pdf — computed once,
  /// from the row's own ids. NEVER a fresh random key per render attempt,
  /// so a crash-and-retry always overwrites the same object.
  storageKey      String?                @map("storage_key")
  generatedAt     DateTime?              @map("generated_at") @db.Timestamptz(6)

  // --- commercial snapshot: written once, at insert, never again ---------
  shipperCompanyId   String  @map("shipper_company_id") @db.Uuid
  shipperCompanyName String  @map("shipper_company_name")
  shipperMcNumber    String? @map("shipper_mc_number")
  shipperDotNumber   String? @map("shipper_dot_number")

  carrierCompanyId String  @map("carrier_company_id") @db.Uuid
  carrierCompanyName String @map("carrier_company_name")
  carrierLegalName String? @map("carrier_legal_name")
  carrierMcNumber  String? @map("carrier_mc_number")
  carrierDotNumber String? @map("carrier_dot_number")

  originAddressLine1 String  @map("origin_address_line1")
  originAddressLine2 String? @map("origin_address_line2")
  originCity         String  @map("origin_city")
  originState        String  @map("origin_state")
  originPostalCode   String  @map("origin_postal_code")
  originCountry      String  @map("origin_country")

  destinationAddressLine1 String  @map("destination_address_line1")
  destinationAddressLine2 String? @map("destination_address_line2")
  destinationCity         String  @map("destination_city")
  destinationState        String  @map("destination_state")
  destinationPostalCode   String  @map("destination_postal_code")
  destinationCountry      String  @map("destination_country")

  pickupWindowStart   DateTime? @map("pickup_window_start") @db.Timestamptz(6)
  pickupWindowEnd     DateTime? @map("pickup_window_end") @db.Timestamptz(6)
  deliveryWindowStart DateTime? @map("delivery_window_start") @db.Timestamptz(6)
  deliveryWindowEnd   DateTime? @map("delivery_window_end") @db.Timestamptz(6)

  equipmentType EquipmentType @map("equipment_type")
  commodity     String?
  weightLbs     Int?    @map("weight_lbs")

  agreedRate     Decimal @map("agreed_rate") @db.Decimal(14, 2)
  currency       String  @default("USD")
  distanceMeters Int?    @map("distance_meters")

  awardedOfferRoundId String   @unique @map("awarded_offer_round_id") @db.Uuid
  /// The SAME `now` value OffersService.accept() already captures once and
  /// reuses for Load.awardedAt / OfferThread.closedAt — never an
  /// independent new Date() call.
  awardedAt           DateTime @map("awarded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  load              Load       @relation(fields: [loadId], references: [id], onDelete: Restrict)
  shipperCompany    Company    @relation("RateConfirmationShipper", fields: [shipperCompanyId], references: [id], onDelete: Restrict)
  carrierCompany    Company    @relation("RateConfirmationCarrier", fields: [carrierCompanyId], references: [id], onDelete: Restrict)
  awardedOfferRound OfferRound @relation("RateConfirmationAwardedRound", fields: [awardedOfferRoundId], references: [id], onDelete: Restrict)

  @@map("rate_confirmations")
}

// ---------------------------------------------------------------------------
// Relationship network + facility scope (Milestone 4 Phase 2)
//
// Core invariant: RELATIONSHIP BELONGS TO COMPANY. FREIGHT VISIBILITY BELONGS
// TO LOAD. None of the models below grant freight access by themselves — they
// are read by later phases (audience/visibility, search, groups-based
// selection) as additional inputs, never as a bypass of Load-based access.
// ---------------------------------------------------------------------------

/// A carrier company's PRIVATE, one-sided bookmark of a shipper company. No
/// approval, no reverse visibility (the shipper never learns it was
/// followed), grants no freight access. Hard-deleted on unfollow — this is
/// not commercial history worth preserving forever, unlike a Connection.
model CarrierFollow {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  carrierCompanyId String   @map("carrier_company_id") @db.Uuid
  shipperCompanyId String   @map("shipper_company_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  carrierCompany Company @relation("FollowCarrier", fields: [carrierCompanyId], references: [id], onDelete: Cascade)
  shipperCompany Company @relation("FollowShipper", fields: [shipperCompanyId], references: [id], onDelete: Cascade)

  @@unique([carrierCompanyId, shipperCompanyId])
  @@index([shipperCompanyId])
  @@map("carrier_follows")
}

/// ONE row per company pair, for the LIFE of that pair — never re-inserted.
/// `companyAId`/`companyBId` are stored in a DETERMINISTIC canonical order
/// (companyAId < companyBId, enforced by a CHECK constraint and matched by
/// `canonicalizeCompanyPair()` in @loadtopia/domain) so a Connection can never
/// exist twice for the same pair in opposite "directions" — the DB-level
/// backstop against a duplicate reverse-direction request race.
///
/// This row holds CURRENT lifecycle state only (PENDING/ACCEPTED/DECLINED/
/// DISCONNECTED) and mutates as the relationship evolves, INCLUDING through a
/// decline/disconnect and back to PENDING on re-request — reconnection is an
/// UPDATE of this same row, never a new row (see CompanyConnectionEvent for
/// the immutable full history of every transition this row has ever made).
model CompanyConnection {
  id     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyAId String       @map("company_a_id") @db.Uuid
  companyBId String       @map("company_b_id") @db.Uuid
  status ConnectionStatus @default(PENDING)

  /// Always equal to companyAId or companyBId (enforced by CHECK) — who
  /// currently holds (or most recently held) the "requester" side.
  requesterCompanyId String   @map("requester_company_id") @db.Uuid
  requestedByUserId  String   @map("requested_by_user_id") @db.Uuid
  requestedAt        DateTime @map("requested_at") @db.Timestamptz(6)

  respondedByUserId String?   @map("responded_by_user_id") @db.Uuid
  respondedAt       DateTime? @map("responded_at") @db.Timestamptz(6)

  /// Set when ACCEPTED -> DISCONNECTED; cleared on a later re-request (the
  /// row is no longer "currently disconnected" — the historical fact of that
  /// disconnect lives forever in CompanyConnectionEvent regardless).
  disconnectedAt DateTime? @map("disconnected_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  companyA          Company                  @relation("ConnectionCompanyA", fields: [companyAId], references: [id], onDelete: Restrict)
  companyB          Company                  @relation("ConnectionCompanyB", fields: [companyBId], references: [id], onDelete: Restrict)
  requesterCompany  Company                  @relation("ConnectionRequester", fields: [requesterCompanyId], references: [id], onDelete: Restrict)
  requestedByUser   User                     @relation("ConnectionRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  respondedByUser   User?                    @relation("ConnectionRespondedByUser", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  events            CompanyConnectionEvent[]

  @@unique([companyAId, companyBId])
  @@index([companyBId])
  @@index([requesterCompanyId])
  @@map("company_connections")
}

/// IMMUTABLE append-only connection lifecycle log — the full truthful history
/// behind CompanyConnection.status, structurally identical in role to
/// OfferEvent behind OfferThread.status. A DB trigger (reusing the existing
/// loadtopia_reject_mutation function) rejects UPDATE/DELETE unconditionally.
///
/// No separate RE_REQUESTED type: a REQUESTED event that isn't the first
/// event for its connectionId is self-evidently a re-request from the
/// sequence itself — a redundant type would encode nothing an event-history
/// reader can't already see.
model CompanyConnectionEvent {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId   String              @map("connection_id") @db.Uuid
  type           ConnectionEventType
  actorUserId    String?             @map("actor_user_id") @db.Uuid
  actorCompanyId String?             @map("actor_company_id") @db.Uuid
  data           Json?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  connection   CompanyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  actor        User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorCompany Company?          @relation(fields: [actorCompanyId], references: [id], onDelete: SetNull)

  @@index([connectionId, createdAt])
  @@map("company_connection_events")
}

/// A shipper company's PRIVATE preference on a carrier company — never a
/// rating, never public, never exposed to the carrier. Current value is
/// mutable (upsert semantics); no history table, matching the product spec's
/// framing of this as an operational note, not commercial/audit history.
model CarrierPreference {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipperCompanyId String                @map("shipper_company_id") @db.Uuid
  carrierCompanyId String                @map("carrier_company_id") @db.Uuid
  preference       CarrierPreferenceType
  setByUserId      String                @map("set_by_user_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  shipperCompany Company @relation("PreferenceShipper", fields: [shipperCompanyId], references: [id], onDelete: Cascade)
  carrierCompany Company @relation("PreferenceCarrier", fields: [carrierCompanyId], references: [id], onDelete: Cascade)
  setByUser      User    @relation(fields: [setByUserId], references: [id], onDelete: Restrict)

  @@unique([shipperCompanyId, carrierCompanyId])
  @@index([carrierCompanyId])
  @@map("carrier_preferences")
}

/// ONE row per block "episode" — PRIVATE to the blocking company; the blocked
/// company is never notified and never sees this row. Unblocking moves this
/// SAME row to INACTIVE (history preserved, never deleted); a LATER re-block
/// between the same two companies in the same direction gets a NEW row (the
/// partial unique index below only forbids more than one CURRENTLY-in-force
/// row per direction — the same pattern as offer_threads_one_accepted_per_load).
/// Blocking is directional: A blocking B is a separate fact from B blocking A.
model CompanyBlock {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockingCompanyId String             @map("blocking_company_id") @db.Uuid
  blockedCompanyId  String             @map("blocked_company_id") @db.Uuid
  status            CompanyBlockStatus @default(ACTIVE)

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When the block actually took/takes effect for future-interaction
  /// purposes: immediately for ACTIVE, or the moment a PENDING_ON_COMPLETION
  /// episode resolves to ACTIVE once the freight that was keeping it pending
  /// ends.
  effectiveAt     DateTime? @map("effective_at") @db.Timestamptz(6)

  removedByUserId String?   @map("removed_by_user_id") @db.Uuid
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(6)

  blockingCompany Company @relation("BlockBlocking", fields: [blockingCompanyId], references: [id], onDelete: Restrict)
  blockedCompany  Company @relation("BlockBlocked", fields: [blockedCompanyId], references: [id], onDelete: Restrict)
  createdByUser   User    @relation("BlockCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  removedByUser   User?   @relation("BlockRemovedByUser", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([blockingCompanyId, status])
  @@index([blockedCompanyId, status])
  @@map("company_blocks")
}

/// A shipper company's PRIVATE, manual collection of its own connected
/// carriers (e.g. "Texas Dry Van", "Backup Capacity"). The carrier never sees
/// the group's name or its own membership in it. `normalizedName` (trimmed,
/// lower-cased at the application layer) backs a case-insensitive-equivalent
/// uniqueness constraint without requiring the citext extension.
model CarrierGroup {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipperCompanyId String   @map("shipper_company_id") @db.Uuid
  name             String
  normalizedName   String   @map("normalized_name")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shipperCompany Company              @relation("CarrierGroupShipper", fields: [shipperCompanyId], references: [id], onDelete: Cascade)
  members        CarrierGroupMember[]

  @@unique([shipperCompanyId, normalizedName])
  @@map("carrier_groups")
}

/// Join of CarrierGroup <-> carrier Company. Removing a member does not
/// disconnect the carrier; deleting the group (Cascade) does not either —
/// group membership is not commercial history, unlike a Connection.
model CarrierGroupMember {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId          String   @map("group_id") @db.Uuid
  carrierCompanyId String   @map("carrier_company_id") @db.Uuid
  addedAt          DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  group          CarrierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  carrierCompany Company      @relation("CarrierGroupMemberCarrier", fields: [carrierCompanyId], references: [id], onDelete: Restrict)

  @@unique([groupId, carrierCompanyId])
  @@index([carrierCompanyId])
  @@map("carrier_group_members")
}

// ---------------------------------------------------------------------------
// Freight audience strategy (Milestone 4 Phase 4)
//
// Core invariant: the SAME Load broadens over time — these rows never cause a
// clone/replacement Load, never touch offers, and never rewrite the load
// state machine. `LoadAudienceStrategyRecord.currentStage` is the single
// authoritative "how far has this load's audience widened" pointer; visibility
// composes it with the UNCHANGED marketplace eligibility rules from Milestone 2
// (see packages/domain/src/audience/audience-visibility.ts).
//
// Historical compatibility: a Load with NO `LoadAudienceStrategyRecord` row is
// a pre-Phase-4 posted load — it behaves exactly as it always did (full
// marketplace visibility to every eligible carrier, no audience restriction).
// This row is created ONCE, at Review & Post, for every load posted from this
// feature forward, and is never backfilled onto historical loads.
// ---------------------------------------------------------------------------

/// One row per Load (created at Review & Post), for the life of that Load.
/// The strategy CHOICE is immutable; `currentStage` advances forward-only as
/// releases execute — this is what lets the SAME Load broaden its audience
/// without ever being cloned or reposted.
model LoadAudienceStrategyRecord {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadId              String                    @unique @map("load_id") @db.Uuid
  strategy            LoadAudienceStrategyType
  /// The visibility boundary currently in effect. Starts at SELECTED
  /// (Selected Carriers First), NETWORK (Network First), or MARKETPLACE
  /// (Marketplace) depending on `strategy`, and only ever moves forward.
  currentStage        LoadAudienceStage         @map("current_stage")
  /// True once the shipper has explicitly turned off further automatic
  /// widening for the CURRENT stage (set at posting when "Don't release
  /// automatically" is chosen, or by an explicit cancel of a pending
  /// release). Release Now remains available regardless.
  autoReleaseDisabled Boolean                   @default(false) @map("auto_release_disabled")
  createdByUserId     String                    @map("created_by_user_id") @db.Uuid
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  load          Load                  @relation(fields: [loadId], references: [id], onDelete: Cascade)
  createdByUser User                  @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  members       LoadAudienceMember[]
  releases      LoadAudienceRelease[]

  @@index([currentStage])
  @@map("load_audience_strategies")
}

/// A concrete, frozen audience-member snapshot for a PRIVATE stage (SELECTED
/// or NETWORK — never MARKETPLACE, which stays open to all otherwise-eligible
/// carriers and needs no finite snapshot). `stage` records WHICH stage this
/// row was captured for, since a load's audience can be snapshotted TWICE
/// over its life: once for SELECTED (at Review & Post, for a Selected
/// Carriers First load) and again for NETWORK (at Review & Post for a
/// Network First load, OR at the moment a SELECTED -> NETWORK release
/// actually executes) — a carrier may legitimately appear in BOTH a SELECTED
/// row and a later, separate NETWORK row for the same load; these are
/// distinct historical facts and are never merged or overwritten.
///
/// This snapshot is HISTORICAL TRUTH ("this carrier was in the audience when
/// this stage was established"), never permanent authorization by itself —
/// current visibility additionally requires a live ACCEPTED Connection and no
/// in-force Block (see isCarrierInAudience). Editing a Carrier Group later,
/// a carrier disconnecting, or new connections forming never mutates this
/// row. `sourceGroupId` is optional provenance for display/audit only (only
/// ever set for a SELECTED-stage row sourced from a group) — it is NEVER
/// read as an authorization source (see NetworkGroupsService et al.: "do not
/// store only a dynamic group reference as the authorization mechanism").
model LoadAudienceMember {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadId           String            @map("load_id") @db.Uuid
  strategyId       String            @map("strategy_id") @db.Uuid
  stage            LoadAudienceStage
  carrierCompanyId String            @map("carrier_company_id") @db.Uuid
  /// Provenance only, nullable (a carrier may have been picked individually,
  /// not via a group; always null for a NETWORK-stage row). No FK — the
  /// source group may be renamed or deleted later without touching this
  /// immutable snapshot.
  sourceGroupId    String?           @map("source_group_id") @db.Uuid
  sourceGroupName  String?           @map("source_group_name")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  load     Load                       @relation(fields: [loadId], references: [id], onDelete: Cascade)
  strategy LoadAudienceStrategyRecord @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  // Powers the carrier-visibility query directly off Load (no join through
  // the strategy needed for "am I a member of this load's CURRENT stage").
  @@unique([loadId, stage, carrierCompanyId])
  @@index([carrierCompanyId])
  @@map("load_audience_members")
}

/// One row per scheduled (or manually executed) audience-widening action.
/// DB-backed source of truth for the release engine — see
/// apps/api/src/modules/loads/release-engine.ts.
///
/// `fromStage` is the exact stage the strategy's `currentStage` MUST equal
/// for this release to be valid to execute — the database-enforced ordering
/// mechanism for a chained release (e.g. SELECTED -> NETWORK, then a second
/// row NETWORK -> MARKETPLACE). Derived once at creation from the chain
/// position (the strategy's own starting stage for the first hop, or the
/// previous hop's `toStage` for a later one) — never re-derived from process-
/// local state, poll timing, or row order, so correctness does not depend on
/// a single poller instance or `findMany` ordering.
///
/// A row is claimed via `SELECT ... FOR UPDATE` on this specific row inside
/// the execution transaction (see executeOneRelease): this is safe under
/// multiple concurrent API instances / duplicate polls — a second claimant
/// blocks until the first commits, then re-reads `status` and no-ops. If the
/// authoritative `currentStage` does not yet equal `fromStage` (the
/// predecessor hop has not executed), the row is left PENDING and retried by
/// a later poll — it is never permanently consumed or cancelled just because
/// it was attempted early.
model LoadAudienceRelease {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadId          String            @map("load_id") @db.Uuid
  strategyId      String            @map("strategy_id") @db.Uuid
  /// The stage the strategy's currentStage must equal for this release to
  /// be valid to execute.
  fromStage       LoadAudienceStage @map("from_stage")
  /// The stage this release, once executed, advances the load TO.
  toStage         LoadAudienceStage @map("to_stage")
  status          LoadReleaseStatus @default(PENDING)
  scheduledAt     DateTime          @map("scheduled_at") @db.Timestamptz(6)
  executedAt      DateTime?         @map("executed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  /// Present only when status = CANCELLED — distinguishes an explicit shipper
  /// cancellation from one superseded by a manual Release Now, or one that
  /// never got the chance to apply because the load became covered/ineligible.
  cancelReason    String?           @map("cancel_reason")
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  load          Load                       @relation(fields: [loadId], references: [id], onDelete: Cascade)
  strategy      LoadAudienceStrategyRecord @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdByUser User                       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  // The release engine's poll query: claim due, still-pending releases.
  @@index([status, scheduledAt])
  @@index([loadId])
  @@map("load_audience_releases")
}

/// Facility scope (Milestone 4 Phase 2): an ADDITIONAL restriction layered on
/// top of role/permission, never a replacement for it. A membership with NO
/// rows here has company-wide access (the default, and the only state a
/// single-location company ever needs); one or more rows restrict that
/// membership to acting only where a matching Location is the origin or
/// destination. Both membershipId and locationId must belong to the SAME
/// company — the database cannot express that cross-table invariant via FK
/// alone, so it is enforced in the service layer inside a transaction (see
/// FacilityScopeService) and covered by an integration test.
model MembershipFacilityScope {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([membershipId, locationId])
  @@index([locationId])
  @@map("membership_facility_scope")
}

// ---------------------------------------------------------------------------
// Security / audit
// ---------------------------------------------------------------------------

/// APPEND-ONLY security audit log for sensitive actions.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  ip          String?
  userAgent   String?  @map("user_agent")
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
